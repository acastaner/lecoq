<?xml version="1.0" encoding="utf-8"?>
<!--
  lecoq's Windows installer (#42, spec §8.5). WiX Toolset v3 source, built by cargo-wix in the
  release workflow's `windows` job (`cargo wix` with no-build, since the job builds the binary with
  the release features first, and this file as its include). cargo-wix defines Version and
  CargoTargetBinDir; RepoDir (the checkout, Windows path) is passed as a compiler argument.

  File associations: a ProgID per readable extension (spec §5.1, the list in `Extensions` below),
  listed under the extension's OpenWithProgids, under Applications\lecoq.exe\SupportedTypes, and in
  the Default Programs capabilities. That puts lecoq in *Open with* and in Settings > Default apps
  and never makes it the default: nothing writes the default value of HKCR\.<ext>. Don't replace
  this with WiX's <ProgId><Extension>, which does write it.

  A new readable format: add its extensions to `Extensions` (and to packaging/macos/Info.plist,
  packaging/windows/winget/*.installer.yaml and the desktop file; packaging/check_associations.py
  compares them all with lecoq_codec::READ_EXTENSIONS).
-->
<?define Extensions = "jpg;jpeg;png;webp;gif;bmp;ico;tif;tiff;avif" ?>
<?define Classes = "Software\Classes" ?>
<?define Capabilities = "Software\lecoq\Capabilities" ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="lecoq"
      UpgradeCode="463029A1-EE94-4B1F-8BED-6B328584C5E2"
      Manufacturer="Arnaud Castaner"
      Language="1033"
      Codepage="1252"
      Version="$(var.Version)">

    <Package
        Id="*"
        Keywords="Installer"
        Description="lecoq, a small, very fast image viewer and quick editor"
        Manufacturer="Arnaud Castaner"
        InstallerVersion="500"
        Languages="1033"
        Compressed="yes"
        InstallScope="perMachine"
        SummaryCodepage="1252"/>

    <MajorUpgrade
        Schedule="afterInstallInitialize"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."/>

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes"/>

    <Icon Id="lecoq.ico" SourceFile="$(var.RepoDir)\packaging\windows\lecoq.ico"/>
    <Property Id="ARPPRODUCTICON" Value="lecoq.ico"/>
    <Property Id="ARPHELPLINK" Value="https://github.com/acastaner/lecoq"/>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/acastaner/lecoq"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="lecoq"/>
      </Directory>
      <Directory Id="ProgramMenuFolder"/>
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Binary" Guid="*">
        <File Id="lecoq.exe" Name="lecoq.exe" Source="$(var.CargoTargetBinDir)\lecoq.exe" KeyPath="yes"/>
      </Component>
      <Component Id="IconFile" Guid="*">
        <File Id="lecoq.ico" Name="lecoq.ico" Source="$(var.RepoDir)\packaging\windows\lecoq.ico" KeyPath="yes"/>
      </Component>
      <Component Id="License" Guid="*">
        <File Id="LICENSE" Name="LICENSE.txt" Source="$(var.RepoDir)\LICENSE" KeyPath="yes"/>
      </Component>

      <Component Id="Associations" Guid="E79FDFBA-E616-4859-8695-BAEA03695F8E">
        <RegistryValue Root="HKLM" Key="Software\lecoq" Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes"/>

        <!-- Applications\lecoq.exe: the name *Open with* shows, and the types it offers lecoq for. -->
        <RegistryValue Root="HKLM" Key="$(var.Classes)\Applications\lecoq.exe" Name="FriendlyAppName" Type="string" Value="lecoq"/>
        <RegistryValue Root="HKLM" Key="$(var.Classes)\Applications\lecoq.exe\DefaultIcon" Type="string" Value="[INSTALLDIR]lecoq.ico"/>
        <RegistryValue Root="HKLM" Key="$(var.Classes)\Applications\lecoq.exe\shell\open\command" Type="string" Value="&quot;[INSTALLDIR]lecoq.exe&quot; &quot;%1&quot;"/>

        <!-- Default Programs: lists lecoq in Settings > Default apps, where the user may choose it. -->
        <RegistryValue Root="HKLM" Key="$(var.Capabilities)" Name="ApplicationName" Type="string" Value="lecoq"/>
        <RegistryValue Root="HKLM" Key="$(var.Capabilities)" Name="ApplicationDescription" Type="string" Value="A small, very fast image viewer and quick editor"/>
        <RegistryValue Root="HKLM" Key="$(var.Capabilities)" Name="ApplicationIcon" Type="string" Value="[INSTALLDIR]lecoq.ico"/>
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="lecoq" Type="string" Value="$(var.Capabilities)"/>

        <?foreach Ext in $(var.Extensions) ?>
        <!-- The ProgID lecoq.$(var.Ext). -->
        <RegistryValue Root="HKLM" Key="$(var.Classes)\lecoq.$(var.Ext)" Type="string" Value="Image (.$(var.Ext))"/>
        <RegistryValue Root="HKLM" Key="$(var.Classes)\lecoq.$(var.Ext)\DefaultIcon" Type="string" Value="[INSTALLDIR]lecoq.ico"/>
        <RegistryValue Root="HKLM" Key="$(var.Classes)\lecoq.$(var.Ext)\shell\open\command" Type="string" Value="&quot;[INSTALLDIR]lecoq.exe&quot; &quot;%1&quot;"/>
        <!-- *Open with* entries only: the value's name is what counts, its data is ignored. -->
        <RegistryValue Root="HKLM" Key="$(var.Classes)\.$(var.Ext)\OpenWithProgids" Name="lecoq.$(var.Ext)" Type="string" Value=""/>
        <RegistryValue Root="HKLM" Key="$(var.Classes)\Applications\lecoq.exe\SupportedTypes" Name=".$(var.Ext)" Type="string" Value=""/>
        <RegistryValue Root="HKLM" Key="$(var.Capabilities)\FileAssociations" Name=".$(var.Ext)" Type="string" Value="lecoq.$(var.Ext)"/>
        <?endforeach ?>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="229C2AF8-0148-4417-B780-9F33030EA15C">
        <Shortcut
            Id="StartMenuShortcut"
            Name="lecoq"
            Description="A small, very fast image viewer and quick editor"
            Target="[INSTALLDIR]lecoq.exe"
            WorkingDirectory="INSTALLDIR"
            Icon="lecoq.ico"/>
        <RegistryValue Root="HKCU" Key="Software\lecoq" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="lecoq" Level="1" Absent="disallow" ConfigurableDirectory="INSTALLDIR">
      <ComponentRef Id="Binary"/>
      <ComponentRef Id="IconFile"/>
      <ComponentRef Id="License"/>
      <ComponentRef Id="Associations"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>
  </Product>
</Wix>
