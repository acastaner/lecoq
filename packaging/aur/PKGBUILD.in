# Maintainer: Arnaud Castaner
# Generated by packaging/linux/build.sh from packaging/aur/PKGBUILD.in (#41); edit the template.
pkgname=lecoq
pkgver=@VERSION@
pkgrel=1
pkgdesc='A small, very fast image viewer and quick editor'
arch=('x86_64' 'aarch64')
url='https://github.com/acastaner/lecoq'
license=('GPL-3.0-or-later')
# winit and glutin dlopen the Wayland, X11 and GL libraries, so they are listed by hand.
# fontconfig and freetype2 are linked by Skia (#25).
depends=('fontconfig' 'freetype2' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'libglvnd' 'libx11'
         'libxcursor' 'libxi' 'libxkbcommon' 'libxrandr' 'wayland')
# cmake, meson, ninja and nasm build libavif and dav1d (linked statically) for AVIF read; curl
# downloads the prebuilt Skia (skia-bindings).
makedepends=('cargo' 'cmake' 'curl' 'meson' 'nasm' 'ninja')
optdepends=('xdg-desktop-portal: native open and save dialogs')
# lecoq was called zimged up to v0.1.6 (#51).
conflicts=('zimged')
replaces=('zimged')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('@SHA256@')

prepare() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${pkgname}-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p lecoq --features avif
}

# No check(): lecoq's tests run in the local gate, which every release has passed (spec §9).

package() {
  cd "${pkgname}-${pkgver}"
  install -Dm755 target/release/lecoq "${pkgdir}/usr/bin/lecoq"
  install -Dm644 packaging/linux/lecoq.desktop "${pkgdir}/usr/share/applications/lecoq.desktop"
  install -Dm644 packaging/linux/lecoq.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/lecoq.svg"
  install -Dm644 packaging/linux/io.github.acastaner.lecoq.metainfo.xml \
    "${pkgdir}/usr/share/metainfo/io.github.acastaner.lecoq.metainfo.xml"
}
